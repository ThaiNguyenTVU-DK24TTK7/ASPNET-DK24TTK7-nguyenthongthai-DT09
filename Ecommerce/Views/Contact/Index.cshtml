@model Ecommerce.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Liên Hệ Với Chúng Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Contact.css" />

<div class="contact-page-container">
    <div class="contact-header">
        <h1>Liên Hệ Với Chúng Tôi</h1>
        <p>Chúng Tôi Luôn Lắng Nghe Và Sẵn Sàng Hỗ Trợ Bạn. Hãy Chia Sẻ Với Chúng Tôi Những Điều Bạn Quan Tâm.</p>
    </div>

    <div class="contact-body">
        <div class="contact-info-card">
            <h4>Thông Tin Liên Hệ</h4>
            <ul>
                <li>
                    <i class="bi bi-geo-alt-fill"></i>
                    <div>
                        <h5>Địa Chỉ</h5>
                        <p>268 Lý Thường Kiệt, Quận 10, TP. Hồ Chí Minh</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-telephone-fill"></i>
                    <div>
                        <h5>Điện Thoại</h5>
                        <p>+84 293 838 9999</p>
                        <p>+84 987 654 321</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-envelope-fill"></i>
                    <div>
                        <h5>Email</h5>
                        <p>support@ttntEcommerce.com</p>
                        <p>info@ttntEcommerce.com</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-clock-fill"></i>
                    <div>
                        <h5>Giờ Mở Cửa</h5>
                        <p>Thứ 2 - Thứ 6: 9:00 - 22:00</p>
                        <p>Thứ 7 - Chủ Nhật: 10:00 - 23:00</p>
                    </div>
                </li>
            </ul>
            <div class="social-icons-contact">
                <a href="#"><i class="bi bi-facebook"></i></a>
                <a href="#"><i class="bi bi-twitter"></i></a>
                <a href="#"><i class="bi bi-instagram"></i></a>
                <a href="#"><i class="bi bi-youtube"></i></a>
            </div>
        </div>

        <div class="contact-form-card">
            <h4>Gửi Tin Nhắn</h4>
            @if (User.Identity.IsAuthenticated)
            {
                if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }
                <form asp-controller="Contact" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label asp-for="NoiDung">Nội Dung Tin Nhắn</label>
                        <textarea asp-for="NoiDung" rows="8" placeholder="Hãy chia sẻ với chúng tôi câu hỏi hoặc phản hồi của bạn..."></textarea>
                        <span asp-validation-for="NoiDung" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn-submit">Gửi Tin Nhắn</button>
                </form>
            }
            else
            {
                <div class="login-prompt">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Vui Lòng Đăng Nhập Để Gửi Tin Nhắn Liên Hệ!</span>
                    <a asp-controller="Account" asp-action="Login" class="btn-login">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                    </a>
                </div>
            }
        </div>
    </div>
</div>
