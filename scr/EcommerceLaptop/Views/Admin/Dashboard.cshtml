@using Ecommerce
@using Ecommerce.Models
@using Newtonsoft.Json
@model Ecommerce.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Trang tổng quan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .summary-stats {
            display: flex;
            flex-wrap: nowrap;
            gap: 24px;
            margin-bottom: 32px;
            overflow-x: auto;
        }
        
        .stat-card {
            min-width: 260px;
            flex: 0 0 260px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 16px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        
        .stat-card.orders {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
        
        .stat-card.users {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
        
        .stat-card.products {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        }
        
        .stat-card.revenue {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        }
        
        .stat-card.contacts {
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            transform: rotate(45deg);
        }
        
        .stat-content {
            position: relative;
            z-index: 2;
        }
        
        .stat-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
            opacity: 0.9;
        }
        
        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        
        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            font-weight: 500;
        }
        
        .stat-change {
            font-size: 0.8rem;
            margin-top: 8px;
            opacity: 0.8;
        }
        
        .stat-change.positive {
            color: #4ade80;
        }
        
        .stat-change.negative {
            color: #f87171;
        }

        .dashboard-widgets {
            display: flex;
            gap: 32px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }
        .dashboard-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            padding: 28px 28px 20px 28px;
            margin-bottom: 24px;
        }
        .dashboard-card h5 {
            font-weight: 700;
            margin-bottom: 18px;
        }
        .dashboard-chart-controls {
            display: flex;
            gap: 8px;
        }
        .dashboard-chart-controls .btn {
            min-width: 60px;
        }
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
            margin: 20px 0;
        }
        .chart-container canvas {
            max-height: 300px !important;
        }
        .top-products .product-img {
            width: 40px; 
            height: 40px; 
            border-radius: 6px;
            overflow: hidden;
            margin-right: 12px;
        }
        .top-products .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .top-products .d-flex { align-items: center; }
        .recent-orders-table th { background: #f3f4f6; font-weight: 600; border-top: none; }
        .recent-orders-table tr { transition: background 0.15s; }
        .recent-orders-table tr:hover { background: #f5f5f5; }
        .badge-status {
            font-size: 0.95em;
            padding: 0.5em 1em;
            border-radius: 1em;
            font-weight: 500;
        }
        .badge-delivered { background: #e0f7fa; color: #00796b; }
        .badge-canceled { background: #fff3e0; color: #e65100; }
        .badge-other { background: #e3e3e3; color: #333; }
        @@media (max-width: 1200px) {
            .dashboard-widgets { flex-direction: column; gap: 18px; }
            .summary-stats { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
        }
    </style>
}

<div>
    <div class="summary-stats">
        <div class="stat-card orders">
            <div class="stat-content">
                <div class="stat-icon">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div class="stat-number">@Model.TotalOrders</div>
                <div class="stat-label">Tổng Đơn Hàng</div>
                <div class="stat-change positive">
                    <i class="bi bi-arrow-up"></i> +12% so với tháng trước
                </div>
            </div>
        </div>
        
        <div class="stat-card users">
            <div class="stat-content">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-number">@Model.TotalUsers</div>
                <div class="stat-label">Người Dùng</div>
                <div class="stat-change positive">
                    <i class="bi bi-arrow-up"></i> +8% so với tháng trước
                </div>
            </div>
        </div>
        
        <div class="stat-card products">
            <div class="stat-content">
                <div class="stat-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="stat-number">@Model.TotalProducts</div>
                <div class="stat-label">Sản Phẩm</div>
                <div class="stat-change positive">
                    <i class="bi bi-arrow-up"></i> +5% so với tháng trước
                </div>
            </div>
        </div>
        
        <div class="stat-card revenue">
            <div class="stat-content">
                <div class="stat-icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div class="stat-number">@Model.TotalRevenue.ToString("N0")</div>
                <div class="stat-label">Doanh Thu (VNĐ)</div>
                <div class="stat-change positive">
                    <i class="bi bi-arrow-up"></i> +15% so với tháng trước
                </div>
            </div>
        </div>
        
        <div class="stat-card contacts">
            <div class="stat-content">
                <div class="stat-icon">
                    <i class="bi bi-envelope"></i>
                </div>
                <div class="stat-number">@Model.TotalContacts</div>
                <div class="stat-label">Tin Nhắn Liên Hệ</div>
                <div class="stat-change @(Model.NewContacts > 0 ? "positive" : "")">
                    <i class="bi bi-@(Model.NewContacts > 0 ? "arrow-up" : "dash")"></i> @Model.NewContacts tin nhắn mới
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-widgets">
        <div style="flex:2; min-width:320px;">
            <div class="dashboard-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Biểu đồ doanh số</h5>
                    <div class="dashboard-chart-controls">
                        <button class="btn btn-sm btn-outline-dark" onclick="loadChartData('week')" id="btn-week">Tuần</button>
                        <button class="btn btn-sm btn-dark" onclick="loadChartData('month')" id="btn-month">Tháng</button>
                        <button class="btn btn-sm btn-outline-dark" onclick="loadChartData('year')" id="btn-year">Năm</button>
                    </div>
                </div>
                <div class="chart-container">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>
        <div style="flex:1; min-width:260px;">
            <div class="dashboard-card mb-4">
                <h5><i class="bi bi-star me-2"></i>Sản Phẩm Bán Chạy</h5>
                <div class="top-products">
                    @foreach (var p in Model.TopProducts)
                    {
                        <div class="d-flex mb-3">
                            <div class="product-img">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="/@p.ImageUrl" alt="@p.ProductName" />
                                }
                                else
                                {
                                    <img src="/images/test1.png" alt="@p.ProductName" />
                                }
                            </div>
                            <div>
                                <div>@p.ProductName</div>
                                <div class="text-muted small">@p.Price.ToString("N0") VNĐ - @p.SoldCount Lượt Bán</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="dashboard-card">
        <h5><i class="bi bi-clock-history me-2"></i>Recent Orders</h5>
        <div class="table-responsive">
            <table class="table recent-orders-table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Customer Name</th>
                        <th>Status</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td>@o.ProductName</td>
                            <td>#@o.OrderId</td>
                            <td>@o.Date.ToString("MMM dd, yyyy")</td>
                            <td>@o.CustomerName</td>
                            <td>
                                @if (o.Status == "Đã giao")
                                {
                                    <span class="badge-status badge-delivered"><i class="bi bi-truck"></i> Delivered</span>
                                }
                                else if (o.Status.Contains("Hủy"))
                                {
                                    <span class="badge-status badge-canceled"><i class="bi bi-x-circle"></i> Canceled</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-other">@o.Status</span>
                                }
                            </td>
                            <td>@o.Amount.ToString("N0") VNĐ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        console.log('Initializing dashboard scripts...');
        
        var initialSalesLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SalesChart.Select(x => x.Label)));
        var initialSalesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SalesChart.Select(x => x.Value)));
        
        console.log('Initial labels:', initialSalesLabels);
        console.log('Initial data:', initialSalesData);
        
        var ctx = document.getElementById('salesChart').getContext('2d');
        var salesChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: initialSalesLabels,
                datasets: [{
                    label: 'Doanh số (VNĐ)',
                    data: initialSalesData,
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59,130,246,0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointBackgroundColor: '#3b82f6',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                aspectRatio: 2.5,
                layout: {
                    padding: {
                        top: 10,
                        bottom: 10
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                plugins: { 
                    legend: { 
                        display: true,
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            padding: 20
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#3b82f6',
                        borderWidth: 1,
                        callbacks: {
                            label: function(context) {
                                var value = context.parsed.y || 0;
                                return 'Doanh số: ' + new Intl.NumberFormat('vi-VN').format(value) + ' VNĐ';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: true,
                            color: 'rgba(0,0,0,0.1)'
                        },
                        ticks: {
                            font: {
                                size: 12
                            }
                        }
                    },
                    y: { 
                        beginAtZero: true,
                        grid: {
                            display: true,
                            color: 'rgba(0,0,0,0.1)'
                        },
                        ticks: {
                            font: {
                                size: 11
                            },
                            callback: function(value) {
                                if (value === 0) return '0';
                                if (value >= 1000000) {
                                    return (value / 1000000).toFixed(1) + 'M VNĐ';
                                } else if (value >= 1000) {
                                    return (value / 1000).toFixed(0) + 'K VNĐ';
                                }
                                return new Intl.NumberFormat('vi-VN').format(value) + ' VNĐ';
                            }
                        }
                    }
                }
            }
        });

        var currentPeriod = 'month';

        function loadChartData(period) {
            console.log('Loading chart data for period:', period);
            
            if (currentPeriod === period) {
                console.log('Same period, skipping...');
                return;
            }
            
            currentPeriod = period;
            updateActiveButton(period);
            
            loadSampleData(period);
            
            var apiUrl = '/Admin/GetSalesChartData?period=' + encodeURIComponent(period);
            console.log('Fetching data from:', apiUrl);
            
            fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'same-origin'
            })
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    console.warn('API failed, using sample data');
                    return null;
                }
                return response.json();
            })
            .then(data => {
                if (data && data.labels && data.values) {
                    console.log('API Data received:', data);
                    salesChart.data.labels = data.labels;
                    salesChart.data.datasets[0].data = data.values;
                    salesChart.data.datasets[0].label = getPeriodLabel(period);
                    salesChart.update('active');
                } else {
                    console.log('Using sample data as fallback');
                }
            })
            .catch(error => {
                console.error('Error loading chart data:', error);
                console.log('Using sample data as fallback');
            });
        }

        function updateActiveButton(period) {
            console.log('Updating active button for period:', period);
            
            document.querySelectorAll('.dashboard-chart-controls .btn').forEach(btn => {
                btn.classList.remove('btn-dark');
                btn.classList.add('btn-outline-dark');
            });
            
            var activeBtn = document.getElementById('btn-' + period);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-dark');
                activeBtn.classList.add('btn-dark');
                console.log('Updated button:', activeBtn.textContent);
            } else {
                console.warn('Button not found for period:', period);
            }
        }

        function getPeriodLabel(period) {
            switch(period) {
                case 'week': return 'Doanh số theo tuần';
                case 'month': return 'Doanh số theo tháng';
                case 'year': return 'Doanh số theo năm';
                default: return 'Doanh số';
            }
        }

        function loadSampleData(period) {
            console.log('Loading sample data for period:', period);
            
            var sampleData = {
                week: {
                    labels: ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'CN'],
                    values: [12500000, 15800000, 9200000, 22000000, 18500000, 25000000, 19800000]
                },
                month: {
                    labels: initialSalesLabels.length > 0 ? initialSalesLabels : ['T6', 'T7', 'T8', 'T9', 'T10', 'T11'],
                    values: initialSalesData.length > 0 ? initialSalesData : [35000000, 42000000, 38000000, 55000000, 48000000, 62000000]
                },
                year: {
                    labels: ['2020', '2021', '2022', '2023', '2024'],
                    values: [280000000, 320000000, 450000000, 520000000, 680000000]
                }
            };
            
            var data = sampleData[period];
            if (data && data.labels && data.values) {
                salesChart.data.labels = data.labels;
                salesChart.data.datasets[0].data = data.values;
                salesChart.data.datasets[0].label = getPeriodLabel(period);
                salesChart.update('active');
                console.log('Sample data loaded successfully for', period);
            } else {
                console.error('Failed to load sample data for period:', period);
            }
        }

        window.testChartUpdate = function() {
            console.log('Testing chart update...');
            loadChartData('week');
        };

        document.addEventListener('DOMContentLoaded', function() {
            console.log('Dashboard loaded, initializing chart controls');
            updateActiveButton('month');
            
            setTimeout(function() {
                if (salesChart.data.datasets[0].data.length === 0 || 
                    salesChart.data.datasets[0].data.every(val => val === 0)) {
                    console.log('No initial data, loading sample month data');
                    loadSampleData('month');
                }
            }, 500);
        });
    </script>
} 
