@model Ecommerce.ViewModels.PhieuNhapDetailViewModel
@{
    ViewData["Title"] = "Chi Tiết Phiếu Nhập";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">Chi Tiết Phiếu Nhập: @Model.MaPhieuNhap</h4>
                    <a asp-action="PhieuNhapList" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Quay Lại
                    </a>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="mb-0">Thông Tin Phiếu Nhập</h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Mã phiếu nhập:</strong></td>
                                            <td>@Model.MaPhieuNhap</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Ngày nhập:</strong></td>
                                            <td>@Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Nhà cung cấp:</strong></td>
                                            <td>@(Model.NhaCungCap ?? "N/A")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Người tạo:</strong></td>
                                            <td>@Model.NguoiTao</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Ngày tạo:</strong></td>
                                            <td>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="mb-0">Thống Kê</h6>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Trạng thái:</strong></td>
                                            <td>
                                                @if (Model.TrangThai == "Hoàn thành")
                                                {
                                                    <span class="badge bg-success">@Model.TrangThai</span>
                                                }
                                                else if (Model.TrangThai == "Đang xử lý")
                                                {
                                                    <span class="badge bg-warning">@Model.TrangThai</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@Model.TrangThai</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Tổng sản phẩm:</strong></td>
                                            <td><span class="badge bg-info">@Model.ChiTietPhieuNhaps.Sum(ct => ct.SoLuongNhap)</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Tổng giá trị:</strong></td>
                                            <td><strong class="text-success fs-5">@Model.TongGiaTri.ToString("N0") VNĐ</strong></td>
                                        </tr>
                                    </table>
                                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                                    {
                                        <div class="mt-3">
                                            <strong>Ghi chú:</strong>
                                            <p class="text-muted">@Model.GhiChu</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Chi Tiết Sản Phẩm Nhập</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Sản Phẩm</th>
                                            <th>Kích Thước</th>
                                            <th>Màu Sắc</th>
                                            <th>Số Lượng</th>
                                            <th>Giá Nhập</th>
                                            <th>Thành Tiền</th>
                                            <th>Ghi Chú</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ChiTietPhieuNhaps)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="/@item.AnhSanPham" alt="@item.TenSanPham" 
                                                             class="me-3 rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                        <div>
                                                            <h6 class="mb-0">@item.TenSanPham</h6>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.KichThuoc))
                                                    {
                                                        <span class="badge bg-secondary">@item.KichThuoc</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">N/A</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.MauSac))
                                                    {
                                                        <span class="badge bg-primary">@item.MauSac</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">N/A</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">@item.SoLuongNhap</span>
                                                </td>
                                                <td>
                                                    <span class="text-success">@item.GiaNhap.ToString("N0") VNĐ</span>
                                                </td>
                                                <td>
                                                    <strong class="text-success">@item.ThanhTien.ToString("N0") VNĐ</strong>
                                                </td>
                                                <td>
                                                    @(item.GhiChu ?? "")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <th colspan="3">Tổng cộng</th>
                                            <th>
                                                <span class="badge bg-info">@Model.ChiTietPhieuNhaps.Sum(ct => ct.SoLuongNhap)</span>
                                            </th>
                                            <th></th>
                                            <th>
                                                <strong class="text-success fs-6">@Model.TongGiaTri.ToString("N0") VNĐ</strong>
                                            </th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            border-top: none;
            font-weight: 600;
        }
        .badge {
            font-size: 0.8em;
        }
        .table-borderless td {
            border: none;
            padding: 0.5rem 0.75rem;
        }
    </style>
}