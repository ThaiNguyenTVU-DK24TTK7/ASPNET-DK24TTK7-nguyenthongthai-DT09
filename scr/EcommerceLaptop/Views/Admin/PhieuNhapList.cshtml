@model List<Ecommerce.ViewModels.PhieuNhapListViewModel>
@{
    ViewData["Title"] = "Quản Lý Phiếu Nhập";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">Danh Sách Phiếu Nhập</h4>
                    <a asp-action="AddPhieuNhap" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Thêm Phiếu Nhập
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Mã Phiếu Nhập</th>
                                    <th>Ngày Nhập</th>
                                    <th>Nhà Cung Cấp</th>
                                    <th>Tổng Sản Phẩm</th>
                                    <th>Tổng Giá Trị</th>
                                    <th>Trạng Thái</th>
                                    <th>Người Tạo</th>
                                    <th>Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><strong>@item.MaPhieuNhap</strong></td>
                                            <td>@item.NgayNhap.ToString("dd/MM/yyyy")</td>
                                            <td>@(item.NhaCungCap ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-info">@item.TongSanPham</span>
                                            </td>
                                            <td>
                                                <strong class="text-success">@item.TongGiaTri.ToString("N0") VNĐ</strong>
                                            </td>
                                            <td>
                                                @if (item.TrangThai == "Hoàn thành")
                                                {
                                                    <span class="badge bg-success">@item.TrangThai</span>
                                                }
                                                else if (item.TrangThai == "Đang xử lý")
                                                {
                                                    <span class="badge bg-warning">@item.TrangThai</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@item.TrangThai</span>
                                                }
                                            </td>
                                            <td>@item.NguoiTao</td>
                                            <td>
                                                <a asp-action="PhieuNhapDetail" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            Chưa có phiếu nhập nào
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            border-top: none;
            font-weight: 600;
        }
        .badge {
            font-size: 0.8em;
        }
    </style>
}