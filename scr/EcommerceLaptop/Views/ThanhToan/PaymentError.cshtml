@{
    ViewData["Title"] = "Lỗi Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="fas fa-exclamation-triangle"></i> Lỗi Thanh Toán</h4>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-times-circle text-danger" style="font-size: 5rem;"></i>
                    </div>
                    
                    <h5 class="card-title text-danger">Thanh toán không thành công!</h5>
                    <p class="card-text">@ViewBag.ErrorMessage</p>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "GioHang")" class="btn btn-primary me-2">
                            <i class="fas fa-shopping-cart"></i> Quay lại giỏ hàng
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                            <i class="fas fa-home"></i> Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }
    
    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }
    
    .btn {
        border-radius: 25px;
        padding: 10px 20px;
    }
</style>