@model Ecommerce.ViewModels.PaymentSuccessViewModel
@{
    ViewData["Title"] = "Thanh Toán Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Xacnhanthanhtoan.css" />
}

<div id="success-modal-overlay" class="modal-overlay visible">
    <div class="success-modal">
        <div class="checkmark"></div>
        <h2>Thanh Toán Thành Công</h2>
        <p>Đơn hàng của bạn đã được xác nhận và thanh toán thành công qua @Model.PaymentMethod.</p>
        
        <div class="payment-details">
            <div class="detail-row">
                <span>Mã đơn hàng:</span>
                <strong>#@Model.OrderId</strong>
            </div>
            <div class="detail-row">
                <span>Số tiền:</span>
                <strong>@Model.Amount VNĐ</strong>
            </div>
            @if (!string.IsNullOrEmpty(Model.TransactionId))
            {
                <div class="detail-row">
                    <span>Mã giao dịch:</span>
                    <strong>@Model.TransactionId</strong>
                </div>
            }
            <div class="detail-row">
                <span>Phương thức:</span>
                <strong>@Model.PaymentMethod</strong>
            </div>
        </div>
        
        <p style="margin-top: 15px; color: #666; font-size: 14px;">Kiểm tra email của bạn để biết thêm chi tiết.</p>
        
        <div class="modal-buttons">
            <button id="go-to-homepage-btn" class="modal-btn primary">Về Trang Chủ</button>
            <button id="check-order-btn" class="modal-btn secondary">Xem Đơn Hàng</button>
        </div>
    </div>
</div>

<style>
    .payment-details {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
        text-align: left;
    }
    
    .detail-row {
        display: flex;
        justify-content: space-between;
        margin: 8px 0;
        padding: 5px 0;
        border-bottom: 1px solid #e9ecef;
    }
    
    .detail-row:last-child {
        border-bottom: none;
    }
    
    .detail-row span {
        color: #6c757d;
    }
    
    .detail-row strong {
        color: #212529;
    }
    .modal-overlay.visible {
        display: flex !important;
        animation: fadeIn 0.3s ease-in-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('success-modal-overlay').classList.add('visible');
        document.getElementById('go-to-homepage-btn').addEventListener('click', function() {
            window.location.href = '/';
        });

        document.getElementById('check-order-btn').addEventListener('click', function() {
            window.location.href = '/Account/OrderHistory';
        });
        setTimeout(function() {
            if (document.getElementById('success-modal-overlay').classList.contains('visible')) {
                window.location.href = '/';
            }
        }, 10000);
    });
</script>